# Fylr environment variables
# Copy this file to .env and fill in your API keys.

# OpenAI API key (required for online mode)
# Used for GPT-4 vision analysis and text generation.
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key (required for Gemini model support)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
